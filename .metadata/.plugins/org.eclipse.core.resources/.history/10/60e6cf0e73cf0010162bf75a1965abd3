//TRANSMIT
void send_IR_UART(){
	if(!stop_interrupt_IR_send){
		if(sending==0){	//prima accensione pwm
			HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3);
			pwm_enabled=1;
			sending=1;
		}else if(sending==1){		//invio effettivo dei bit
			if(count_bit<=7){
				uint8_t bit = (key_press_buffer[buff_tail] >> count_bit) & 0x01;
				if( bit==0 && pwm_enabled==0){ //bit=0 accendo pwm. la accendo solo se non era già accesa
					HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3);
					pwm_enabled=1;
				}else if(bit==1 && pwm_enabled==1){ //bit=1 spengo pwm, la spengo solo se non era già accesa
					HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);
					pwm_enabled=0;
				}
			}else if(pwm_enabled==1){
				HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);
				pwm_enabled=0;
			}
			count_bit++;
		}

		if(count_bit>8){
			count_bit=0;
			sending=0;
//				if(pwm_enabled==1){
//					HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);
//				}
			buff_tail = (buff_tail + 1) % BUFFER_SIZE;
			if(buff_head == buff_tail){
				if(pwm_enabled == 1){
					HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);
					pwm_enabled = 0;
				}
				pwm_enabled = 0;

				stop_interrupt_IR_send=1;
				HAL_TIM_Base_Stop_IT(&htim3);
			}
		}
	}
}

void read_keyboard(){
	if (HAL_GPIO_ReadPin(PIN_PC12) == 1) {
		key_pressed[0][scan_column] = 0;
		character_printed[0][scan_column] = 0;
	}
	else {
		key_pressed[0][scan_column]++;
	}

	if (HAL_GPIO_ReadPin(PIN_PC13) == 1) {
		key_pressed[1][scan_column] = 0;
		character_printed[1][scan_column] = 0;
	}
	else {
		key_pressed[1][scan_column]++;
	}

	if (HAL_GPIO_ReadPin(PIN_PC2) == 1) {
		key_pressed[2][scan_column] = 0;
		character_printed[2][scan_column] = 0;
	}
	else {
		key_pressed[2][scan_column]++;
	}

	if (HAL_GPIO_ReadPin(PIN_PC3) == 1) {
		key_pressed[3][scan_column] = 0;
		character_printed[3][scan_column] = 0;
	}
	else {
		key_pressed[3][scan_column]++;
	}


	scan_column ++;
	if (scan_column > 3)
		scan_column = 0;


	HAL_GPIO_WritePin(PIN_PC11, (scan_column == 3)? 1:0);
	HAL_GPIO_WritePin(PIN_PC10, (scan_column == 2)? 1:0);
	HAL_GPIO_WritePin(PIN_PC9, (scan_column == 1)? 1:0);
	HAL_GPIO_WritePin(PIN_PC8, (scan_column == 0)? 1:0);

	for( int i = 0; i<4;i++) {

		for(int j = 0; j<4; j++) {
			if (key_pressed[i][j] > TIME_PERIOD_DEBOUNCE) {

				if (character_printed[i][j] == 0) {

//	    				HAL_UART_Transmit_DMA(&huart2, &keyboard[i][j],1);
					uint8_t next_head = (buff_head + 1) % BUFFER_SIZE;

					if (next_head != buff_tail) { //check buffer full, if not save key on buffer
						key_press_buffer[buff_head] = keyboard[i][j];
						buff_head = next_head;
					}

					character_printed[i][j] = 1;

					if(stop_interrupt_IR_send == 1) {
					    stop_interrupt_IR_send = 0;
					    __HAL_TIM_SET_COUNTER(&htim3, 0);
					    HAL_TIM_Base_Start_IT(&htim3);
					}
				}
			}
		}
	}
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
	if(htim->Instance == TIM3){
		send_IR_UART();
	}
	if(htim->Instance == TIM4){
		read_keyboard();
	}
}

//RECEIVE
void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart ){
	if (huart->Instance == USART1){
		length_lcd = strlen((char*) string_lcd);

		if (length_lcd >= N_CHAR) {
			string_lcd[0] = '\0';
			length_lcd = 0;
		}

		string_lcd[length_lcd] = char_receive;
		string_lcd[length_lcd + 1] = '\0';

		lcd_println(string_lcd, 0);

		HAL_UARTEx_ReceiveToIdle_IT(&huart1, &char_receive, 1);
	}
}


